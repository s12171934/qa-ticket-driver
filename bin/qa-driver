#!/usr/bin/env python3
"""qa-driver — one QA parent ticket: pick its open child tickets, give each its own worktree, start a coordinator there.

    qa-driver init     <PARENT>                       state directory with config.env / context.md skeletons
    qa-driver run      <PARENT> [--dry-run|--pending] one round: select tickets, drive each, clean up merged ones
                                                      (scheduler entry point)
    qa-driver drive    <PARENT> <KEY>                 one ticket: worktree (created or reused) + coordinator terminal
    qa-driver worker   <PARENT> <KEY> <SUBMODULE>     coordinator only: worker terminal in the same worktree
    qa-driver worker   <PARENT> <KEY> --screen        coordinator only: screen-measurement worker in the same worktree
    qa-driver status   <PARENT> [--json]              stage of every claimed ticket (exports/state-contract.md)
    qa-driver approve  <PARENT> <KEY> [--force]       record push/PR approval and tell the coordinator
    qa-driver merge    <PARENT> <KEY>                 delivered ticket: record the merge order and tell the coordinator
    qa-driver tell     <PARENT> --to <HANDLE> --body <TEXT|-> [--type T] [--subject S] [--key KEY]
                                                      type a message into another agent's terminal and log it
                                                      (log/tell.jsonl — the dashboard's interaction tab reads it)
    qa-driver cleanup  <PARENT> <KEY> [--force|--dry-run]  deinit submodules and remove the ticket worktree
    qa-driver ignore   <PARENT> <KEY> [--undo]        keep a ticket out of selection
    qa-driver restart  <PARENT> <KEY> [--force]       start the ticket's coordinator again with its existing brief
    qa-driver close    <PARENT> <KEY>...              close the tickets' live coordinator / worker terminals
    qa-driver retire   <PARENT> [--dry-run|--force]   end of QA: disable its automations, close the shared
                                                      coordination worktree's terminals and remove that worktree
    qa-driver adopt    <PARENT> [--check] [--set K=V]... [--automation ID]
                                                      take over an older watcher: fill missing config keys and point
                                                      its Orca automation at `qa-driver run`

State lives in $QA_DRIVER_HOME/<parent in lower case>/ (default ~/.qa-driver). --home <dir> points at another home,
e.g. an older watcher's. Python 3 standard library only; needs the `orca` CLI, git, and `gh` for the merge check.
"""
import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from urllib.parse import urlencode
from urllib.request import Request, urlopen
import base64

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REF = os.path.join(SKILL_DIR, "references")
TELL_TYPES = ("dispatch", "status", "question", "answer", "escalation", "handoff", "merge_ready", "decision_gate")
SIGNALS = ("handoffs", "done", "ready", "blocked", "approved", "delivered", "merge", "cleaned")  # moved to rounds/ on a reopen


def die(msg, code=1):
    print(f"qa-driver: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")


# ---------- state directory and config ----------
class State:
    def __init__(self, parent, home=None):
        self.parent = parent
        self.home = os.path.expanduser(home or os.environ.get("QA_DRIVER_HOME") or "~/.qa-driver")
        self.dir = os.path.join(self.home, parent.lower())
        self.cfg = {}

    def p(self, *parts):
        return os.path.join(self.dir, *parts)

    def load(self, need=()):
        path = self.p("config.env")
        if not os.path.isfile(path):
            die(f"{path} 없음 — 먼저 qa-driver init {self.parent}")
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = shlex.split(v, comments=True)
            self.cfg[k.strip()] = os.path.expandvars(os.path.expanduser(v[0])) if v else ""
        for k in need:
            if not self.get(k):
                die(f"config.env 에 {k} 가 없다 (references/config.env.example)")
        return self

    def get(self, k, default=""):
        return self.cfg.get(k) or os.environ.get(k) or default

    def ticket(self, key):
        try:
            with open(self.p("tickets", f"{key}.json"), encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return {"key": key}

    def save_ticket(self, t):
        os.makedirs(self.p("tickets"), exist_ok=True)
        t["updated_at"] = now()
        tmp = self.p("tickets", f'{t["key"]}.json.tmp')
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(t, f, ensure_ascii=False, indent=1)
        os.replace(tmp, self.p("tickets", f'{t["key"]}.json'))

    def claims(self, key):
        try:
            return [l.rstrip("\n").split("\t") for l in open(self.p("claimed", key), encoding="utf-8") if l.strip()]
        except OSError:
            return []

    def has(self, kind, key):
        """A signal file of this ticket: <kind>/<KEY>.md or a per-repo <kind>/<KEY>-<repo>.md (not a .roundN copy)."""
        d = self.p(kind)
        if not os.path.isdir(d):
            return []
        pat = re.compile(rf"^{re.escape(key)}(?:-[^.]+)?(?:\.md)?$")
        return sorted(f for f in os.listdir(d) if pat.match(f))


class Lock:
    def __init__(self, st):
        self.path = st.p(".lock")

    def __enter__(self):
        for _ in range(60):
            try:
                os.mkdir(self.path)
                return self
            except FileExistsError:
                time.sleep(2)
        die(f"{self.path} 를 2분째 다른 회차가 잡고 있다 (도는 회차가 없으면 손으로 지운다)")

    def __exit__(self, *a):
        try:
            os.rmdir(self.path)
        except OSError:
            pass


def log(st, msg):
    os.makedirs(st.p("log"), exist_ok=True)
    line = f"[{now()}] {msg}"
    print(line)
    with open(st.p("log", datetime.date.today().strftime("%Y%m%d") + ".log"), "a", encoding="utf-8") as f:
        f.write(line + "\n")


# ---------- outside tools ----------
def orca(*args, timeout=60):
    r = subprocess.run(["orca", *args, "--json"], capture_output=True, text=True, timeout=timeout)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        raise RuntimeError((r.stdout or r.stderr).strip()[:300])
    if d.get("ok") is not True:
        raise RuntimeError(json.dumps(d.get("error") or d, ensure_ascii=False)[:300])
    return d.get("result") or {}


def find(node, key):
    """First value of `key` anywhere in a JSON tree."""
    if isinstance(node, dict):
        if isinstance(node.get(key), str):
            return node[key]
        node = list(node.values())
    if isinstance(node, list):
        for c in node:
            v = find(c, key)
            if v:
                return v
    return None


def git(path, *args, timeout=60):
    r = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, timeout=timeout)
    return r.stdout.strip() if r.returncode == 0 else None


def jira_token(st):
    t = os.environ.get("ATLASSIAN_API_TOKEN") or st.get("ATLASSIAN_API_TOKEN")
    svc = st.get("QA_JIRA_TOKEN_KEYCHAIN_SERVICE")
    if not t and svc:
        r = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"], capture_output=True, text=True)
        t = r.stdout.strip()
    if not t:
        die("Jira 토큰 없음 — ATLASSIAN_API_TOKEN 또는 config.env QA_JIRA_TOKEN_KEYCHAIN_SERVICE")
    return t


def jira_search(st, jql, fields, expand=None):
    """Every issue the JQL matches, across pages."""
    auth = base64.b64encode(f'{st.get("JIRA_EMAIL")}:{jira_token(st)}'.encode()).decode()
    site = st.get("JIRA_SITE").removeprefix("https://").rstrip("/")
    out, nxt = [], None
    while True:
        q = {"jql": jql, "fields": fields, "maxResults": "100"}
        if expand:
            q["expand"] = expand
        if nxt:
            q["nextPageToken"] = nxt
        req = Request(f"https://{site}/rest/api/3/search/jql?{urlencode(q)}",
                      headers={"Authorization": "Basic " + auth, "Accept": "application/json"})
        with urlopen(req, timeout=30) as r:
            d = json.load(r)
        out += d.get("issues") or []
        nxt = d.get("nextPageToken")
        if not nxt or d.get("isLast", True):
            return out


def jira_open_children(st):
    """[(key, status, last reopen epoch, summary)] for the parent's tickets in the new / reopen states."""
    new, reopen = st.get("QA_STATUS_NEW", "To Do"), st.get("QA_STATUS_REOPEN", "Reopened")
    jql = st.get("QA_JQL") or f'parent = {st.parent} AND status IN ("{new}", "{reopen}") ORDER BY created ASC'
    out = []
    for i in jira_search(st, jql, "summary,status", expand="changelog"):
        last = 0
        for h in (i.get("changelog") or {}).get("histories") or []:
            if any(it.get("field") == "status" and it.get("toString") == reopen for it in h.get("items") or []):
                ts = datetime.datetime.strptime(h["created"], "%Y-%m-%dT%H:%M:%S.%f%z").timestamp()
                last = max(last, int(ts))
        out.append((i["key"], i["fields"]["status"]["name"], last, (i["fields"].get("summary") or "").replace("\t", " ")))
    return out, reopen


def jira_done_keys(st):
    """Keys of the parent's tickets in a QA_STATUS_DONE state (comma-separated names). Unset = none."""
    names = [n.strip() for n in st.get("QA_STATUS_DONE", "").split(",") if n.strip()]
    if not names:
        return set()
    jql = f'parent = {st.parent} AND status IN ({", ".join(chr(34) + n + chr(34) for n in names)})'
    return {i["key"] for i in jira_search(st, jql, "status")}


# ---------- stages (exports/state-contract.md) ----------
STAGES = ["selected", "worktree", "analysis", "implementing", "reviewing", "committed", "approved", "delivered", "cleaned"]


def stage_of(st, key):
    if os.path.exists(st.p("cleaned", key)):
        return "cleaned"
    for kind, stage in (("delivered", "delivered"), ("approved", "approved"), ("ready", "committed")):
        if f"{key}.md" in st.has(kind, key):
            return stage
    hand = [f for f in st.has("handoffs", key) if not f.endswith(("-deliver.md", "-screen.md"))]
    done = [f for f in st.has("done", key) if not f.endswith("-screen.md")]
    if hand and done and len(done) >= len(hand):
        return "reviewing"
    if hand:
        return "implementing"
    t = st.ticket(key)
    if t.get("coordinator") or (not t.get("driver") and st.claims(key)):  # an older watcher keeps no ticket record
        return "analysis"
    return "worktree" if t.get("worktree") else "selected"


def status_rows(st):
    rows = []
    for key in sorted(os.listdir(st.p("claimed")) if os.path.isdir(st.p("claimed")) else [], key=lambda k: int(re.sub(r"\D", "", k) or 0)):
        t, cl = st.ticket(key), st.claims(key)
        rows.append({"key": key, "stage": stage_of(st, key), "blocked": bool(st.has("blocked", key)),
                     "ignored": os.path.exists(st.p("ignored", key)), "round": len(cl),
                     "claimed_at": cl[-1][0] if cl else None, "worktree": (t.get("worktree") or {}).get("path"),
                     "coordinator": (t.get("coordinator") or {}).get("handle") or (cl[-1][2] if cl and len(cl[-1]) > 2 else None),
                     "workers": t.get("workers") or {}, "summary": t.get("summary") or (cl[-1][3] if cl and len(cl[-1]) > 3 else "")})
    return rows


ACTIVE = ("selected", "worktree", "analysis", "implementing", "reviewing")  # a ticket that still has work before review ends


def active(st):
    return [r for r in status_rows(st) if r["stage"] in ACTIVE and not r["blocked"] and not r["ignored"]]


# ---------- briefs ----------
def render(st, out, templates, key, extra=None):
    ctx_path = st.p("context.md")
    ctx = open(ctx_path, encoding="utf-8").read().strip() if os.path.isfile(ctx_path) else "(기능 맥락 파일이 없다 — 사용자에게 묻는다.)"
    vals = {"KEY": key, "PARENT_KEY": st.parent, "STATE_DIR": st.dir, "TODAY": datetime.date.today().isoformat(),
            "RECORD_DIR": st.get("QA_RECORD_DIR", st.p("records")), "AUTO_HANDOFF": st.get("QA_AUTO_HANDOFF"),
            "REPO": st.get("QA_REPO"), "JIRA_SITE": st.get("JIRA_SITE").removeprefix("https://").rstrip("/"),
            "JIRA_EMAIL": st.get("JIRA_EMAIL"), "HARNESS_DOCS": st.get("QA_HARNESS_DOCS", "AGENTS.md"),
            "TICKET_SKILLS": st.get("QA_TICKET_SKILLS") or "(없음 — 하네스 문서의 규칙을 따른다)",
            "SCREEN_SKILLS": st.get("QA_SCREEN_SKILLS") or "(없음 — 인계 브리프가 정한 방법을 따른다)",
            "DRIVER": os.path.join(SKILL_DIR, "bin", "qa-driver"), "HOME_OPT": f'--home "{st.home}"',
            "TOKEN_HINT": f'`security find-generic-password -s {st.get("QA_JIRA_TOKEN_KEYCHAIN_SERVICE")} -w`'
            if st.get("QA_JIRA_TOKEN_KEYCHAIN_SERVICE") else "사용자에게 묻는다", **(extra or {})}
    text = "\n\n---\n\n".join(open(os.path.join(REF, t), encoding="utf-8").read() for t in templates)
    text = text.replace("@@CONTEXT@@", ctx)

    def sub(m):
        if m.group(1) not in vals:
            die(f"치환되지 않은 자리표시자 @@{m.group(1)}@@")
        return str(vals[m.group(1)])
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(re.sub(r"@@([A-Z_]+)@@", sub, text))
    return out


def start_agent(st, worktree, title, prompt_file, intro):
    """New terminal in the worktree running the agent; sends 'read this file'. -> handle."""
    res = orca("terminal", "create", "--worktree", f"path:{worktree}", "--title", title,
               "--command", st.get("QA_AGENT_COMMAND", "claude"))
    handle = find(res, "handle")
    if not handle:
        raise RuntimeError("터미널 handle 없음: " + json.dumps(res)[:200])
    try:
        orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle", "--timeout-ms", "120000", timeout=150)
    except Exception:
        pass  # an agent that never reports idle still takes the text
    key = re.match(r"[A-Z][A-Z0-9]+-\d+", title)
    tell(st, handle, f"Read the file {prompt_file} and follow its instructions exactly. {intro}",
         "dispatch", f"{title} 시작", key[0] if key else "")
    return handle


def tell(st, handle, text, kind="status", subject="", key="", sender=None):
    """Type text into another agent's terminal and add one line to log/tell.jsonl. Orca keeps no history of terminal
    input, and an inbox copy would sit unread in the receiver's mailbox, so the dashboard's interaction tab reads this log."""
    rec = {"at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
           "from": sender or os.environ.get("ORCA_TERMINAL_HANDLE") or "qa-driver", "to": handle, "type": kind,
           "subject": subject, "body": text, "key": key, "parent": st.parent, "ok": True}
    try:
        orca("terminal", "send", "--terminal", handle, "--text", text, "--enter")
    except Exception as e:
        rec.update(ok=False, error=str(e)[:300])
        raise
    finally:
        try:
            os.makedirs(st.p("log"), exist_ok=True)
            with open(st.p("log", "tell.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        except OSError:
            pass  # a missing record never blocks the message


def live_handles():
    try:
        return {t.get("handle") for t in (orca("terminal", "list").get("terminals") or []) if t.get("connected")}
    except Exception:
        return set()


# ---------- commands ----------
def cmd_init(st, a):
    os.makedirs(st.dir, exist_ok=True)
    for d in ("briefs", "claimed", "tickets", "ignored", "scratch", "log", "rounds") + SIGNALS + ("cleaned",):
        os.makedirs(st.p(d), exist_ok=True)
    tpl = os.path.join(REF, "config.env.example")
    if not os.path.exists(st.p("config.env")):
        shutil.copy(tpl, st.p("config.env"))
        os.chmod(st.p("config.env"), 0o600)
    if not os.path.exists(st.p("context.md")):
        shutil.copy(os.path.join(REF, "context.md.example"), st.p("context.md"))
    print(st.dir)


def drive(st, key, status="", summary="", reopen=False):
    t = st.ticket(key)
    t.update(key=key, parent=st.parent, driver=True)
    if summary:
        t["summary"] = summary
    rnd = len(st.claims(key)) + 1
    if rnd > 1 and reopen:  # earlier round's signals go to rounds/<KEY>/<n>/ so the stage starts over
        dest = st.p("rounds", key, str(rnd - 1))
        for kind in SIGNALS:
            for f in st.has(kind, key):
                os.makedirs(os.path.join(dest, kind), exist_ok=True)
                shutil.move(st.p(kind, f), os.path.join(dest, kind, f))
    wt = (t.get("worktree") or {}).get("path")
    if not (wt and os.path.isdir(wt)):
        args = ["worktree", "create", "--repo", f'path:{st.get("QA_REPO")}', "--name", key,
                "--comment", f"QA {st.parent} · {t.get('summary', '')}"[:200]]
        args += ["--parent-worktree", f'path:{st.get("QA_PARENT_WORKTREE")}'] if st.get("QA_PARENT_WORKTREE") else ["--no-parent"]
        if st.get("QA_BASE_BRANCH"):
            args += ["--base-branch", st.get("QA_BASE_BRANCH")]
        if st.get("QA_WORKTREE_SETUP"):
            args += ["--setup", st.get("QA_WORKTREE_SETUP")]
        res = orca(*args, timeout=300)
        wt = find(res, "path")
        if not wt or not os.path.isdir(wt):
            raise RuntimeError("워크트리 경로 없음: " + json.dumps(res)[:300])
        t["worktree"] = {"path": wt, "id": find(res, "id"), "created_at": now()}
        st.save_ticket(t)
        log(st, f"WORKTREE {key} {wt}")
    templates = (["brief-reopen.md"] if rnd > 1 else []) + ["brief-coordinator.md"]
    brief = render(st, st.p("briefs", f"{key}.md"), templates, key, {"WORKTREE": wt, "ROUND": rnd})
    for duties in ("worker-duties.md", "screen-duties.md"):
        render(st, st.p(duties), [duties], "<티켓키>", {"WORKTREE": "<워크트리>", "ROUND": "<회차>"})
    handle = start_agent(st, wt, f"{key} 코디네이터", brief, "그 파일의 지시를 그대로 수행하라.")
    os.makedirs(st.p("claimed"), exist_ok=True)
    with open(st.p("claimed", key), "a", encoding="utf-8") as f:
        f.write(f"{now()}\t{int(time.time())}\t{handle}\t{t.get('summary', '')}\n")
    t["coordinator"] = {"handle": handle, "at": now(), "round": rnd}
    t["round"] = rnd
    st.save_ticket(t)
    log(st, f"DRIVE({status or 'manual'}) {key} round {rnd} ({handle}) — {t.get('summary', '')}")


def cmd_run(st, a):
    st.load(need=("JIRA_SITE", "JIRA_EMAIL", "QA_REPO", "QA_AUTO_HANDOFF", "QA_STATUS_NEW", "QA_STATUS_REOPEN"))
    if st.get("QA_AUTO_HANDOFF") not in ("yes", "no"):
        die("config.env QA_AUTO_HANDOFF 는 yes/no — 설정 때 사용자에게 한 번 묻고 적는다")
    tickets, reopen = jira_open_children(st)
    done_keys = jira_done_keys(st)
    picks = []
    for key, status, reopened, summary in tickets:
        if os.path.exists(st.p("ignored", key)):
            continue
        cl = st.claims(key)
        if cl:
            if status != reopen or reopened <= int(cl[-1][1] or 0):
                continue
        picks.append((key, status, summary, bool(cl)))
    room = max(0, int(st.get("QA_MAX_ACTIVE", "6")) - len(active(st)))
    take = picks[:min(room, int(st.get("QA_MAX_NEW_PER_RUN", "10")))]
    msg = f"조회 {len(tickets)}건 · 기동 후보 {len(picks)}건 · 동시 상한 여유 {room} → 이번 회차 {len(take)}건"
    if a.pending or a.dry_run:
        cleans = finished_cleanups(st, done_keys)
        ready = [k for k, _, problems in cleans if not problems]
        msg += f" · 완료 정리 {len(ready)}건"
    if a.pending:
        print(msg, file=sys.stderr)
        sys.exit(0 if take or ready else 1)
    if a.dry_run:
        print(msg)
        for k, s, summ, re_ in take:
            print(f"기동 예정: {k}\t{s}{' (재기동)' if re_ else ''}\t{summ}")
        for k, plan, problems in cleans:
            print(f"정리 {'보류' if problems else '예정'}: {k}\t{plan[0][0]}" + (f"\t{' · '.join(problems)}" if problems else ""))
        return
    with Lock(st):
        log(st, msg)
        for key, status, summary, re_ in take:
            try:
                drive(st, key, status, summary, reopen=re_)
            except Exception as e:
                log(st, f"ERROR {key}: {e}")
        sweep_finished(st, done_keys)


def cmd_drive(st, a):
    st.load(need=("QA_REPO", "QA_AUTO_HANDOFF"))
    with Lock(st):
        drive(st, a.key, reopen=bool(st.claims(a.key)))


def cmd_worker(st, a):
    st.load()
    t = st.ticket(a.key)
    wt = (t.get("worktree") or {}).get("path")
    if not wt:
        die(f"{a.key} 의 워크트리 기록이 없다 (qa-driver drive 로 기동한 티켓만)")
    if a.screen == bool(a.submodule):
        die("서브모듈 경로와 --screen 중 하나만 준다")
    name = "screen" if a.screen else re.sub(r"[^A-Za-z0-9._-]+", "-", a.submodule.strip("/")) if a.submodule != "." else "root"
    hand = st.p("handoffs", f"{a.key}-{name}.md")
    if not os.path.isfile(hand):
        die(f"{hand} 가 없다 — 인계 브리프를 먼저 쓴다")
    duties = "screen-duties.md" if a.screen else "worker-duties.md"
    render(st, st.p(duties), [duties], "<티켓키>", {"WORKTREE": "<워크트리>", "ROUND": "<회차>"})
    role = "화면 실측을 맡는다" if a.screen else f"너의 저장소는 {a.submodule}"
    handle = start_agent(st, wt, f"{a.key} 워커 {name}", hand,
                         f"그 다음 {st.p(duties)} 의 의무를 따른다. {role}, 신호 파일 이름은 {a.key}-{name}.md 다.")
    t.setdefault("workers", {})[name] = {"handle": handle, "submodule": a.submodule or "", "at": now()}
    st.save_ticket(t)
    log(st, f"WORKER {a.key} {name} ({handle})")
    print(handle)


def cmd_status(st, a):
    rows = status_rows(st)
    if a.json:
        print(json.dumps({"parent": st.parent, "state_dir": st.dir, "stages": STAGES, "tickets": rows}, ensure_ascii=False, indent=1))
        return
    for r in rows:
        print(f'{r["key"]:<10} {r["stage"]:<12}{" 막힘" if r["blocked"] else ""}{" 제외" if r["ignored"] else ""} {r["round"]}회차  {r["summary"][:60]}')


def cmd_approve(st, a):
    st.load()
    key = a.key
    if f"{key}.md" not in st.has("ready", key) and not a.force:
        die(f"{key}: ready/{key}.md 가 없다 — 코디네이터 검토가 끝난 티켓만 승인한다 (--force 로 무시)")
    os.makedirs(st.p("approved"), exist_ok=True)
    with open(st.p("approved", f"{key}.md"), "w", encoding="utf-8") as f:
        f.write(f"# {key} 반출 승인\n\n- 시각: {now()}\n- 승인: {a.by}\n- 범위: ready/{key}.md 의 브랜치 push · PR 생성 (머지는 따로)\n")
    text = (f"[qa-driver] 사용자가 {key} 반출(push·PR)을 승인했다 — {st.p('approved', key + '.md')}. "
            f"브리프의 반출 단계를 진행하고, 끝나면 {st.p('delivered', key + '.md')} 에 PR 주소를 남겨라.")
    tell_coordinator(st, key, text, "반출", "deliver", "approved")
    log(st, f"APPROVE {key} by {a.by}")


def tell_coordinator(st, key, text, title, purpose, signal):
    """Send text to the ticket's live coordinator, or start one with its brief in the ticket worktree."""
    t, cl = st.ticket(key), st.claims(key)
    handle = (t.get("coordinator") or {}).get("handle") or (cl[-1][2] if cl and len(cl[-1]) > 2 else None)
    if handle and handle in live_handles():
        tell(st, handle, text, "dispatch", f"{key} {title}", key)
        print(f"전달: {handle}")
        return
    wt = (t.get("worktree") or {}).get("path")
    if not wt:
        print(f"코디네이터 터미널이 닫혔고 워크트리 기록이 없다 — {signal} 파일만 남겼다")
        return
    h = start_agent(st, wt, f"{key} 코디네이터 ({title})", st.p("briefs", f"{key}.md"), text)
    t["coordinator"] = {"handle": h, "at": now(), "round": t.get("round"), "for": purpose}
    st.save_ticket(t)
    print(f"새 코디네이터: {h}")


def cmd_tell(st, a):
    if not os.path.isdir(st.dir):
        die(f"{st.dir} 없음 — 부모 티켓·--home 을 확인한다")
    body = sys.stdin.read().rstrip("\n") if a.body == "-" else a.body
    if not body.strip():
        die("--body 가 비었다")
    tell(st, a.to, body, a.type, a.subject, a.key or "", a.sender)
    print(f"전달: {a.to}")


def cmd_merge(st, a):
    st.load()
    key = a.key
    if f"{key}.md" not in st.has("delivered", key):
        die(f"{key}: delivered/{key}.md 가 없다 — PR 을 올린(반출된) 티켓만 머지를 지시한다")
    prs = PR_URL.findall(open(st.p("delivered", f"{key}.md"), encoding="utf-8").read())
    if not prs:
        die(f"{key}: delivered/{key}.md 에 PR 주소가 없다")
    os.makedirs(st.p("merge"), exist_ok=True)
    with open(st.p("merge", f"{key}.md"), "w", encoding="utf-8") as f:
        f.write(f"# {key} 머지 지시\n\n- 시각: {now()}\n- 지시: {a.by}\n- 대상: " + " ".join(prs) + "\n")
    # Self-contained: a brief rendered before the merge stage existed does not describe it.
    text = (f"[qa-driver] 사용자가 {key} PR 머지를 지시했다 — {st.p('merge', key + '.md')}. 대상: {' '.join(prs)}. "
            "의존 저장소의 PR 부터 머지하고, 소비처의 핀(서브모듈 포인터 등)은 머지된 해시로 갱신해 push 한 뒤 머지하라 "
            "(squash 는 해시가 바뀐다). 체크 실패·충돌·리뷰 요구로 머지할 수 없으면 머지하지 말고 "
            f"{st.p('blocked', key + '.md')} 에 사유를 남겨라. Jira 「개발 완료」 전이와 전달 코멘트는 PR 이 모두 머지된 뒤에만 한다"
            "(형식은 티켓 규칙 스킬대로, 머지 전에는 전이하지 않는다). "
            "워크트리 정리는 하지 않는다(PR 이 모두 머지되면 드라이버 회차가 터미널을 닫고 지운다).")
    tell_coordinator(st, key, text, "머지", "merge", "merge")
    log(st, f"MERGE-ORDER {key} by {a.by}")


def ticket_worktrees(st, key):
    """The ticket's worktrees: the driver's record, or (an older watcher) Orca worktrees named after the key."""
    wt = (st.ticket(key).get("worktree") or {}).get("path")
    if wt:
        return [wt]
    try:
        ws = orca("worktree", "list").get("worktrees") or []
    except Exception:
        return []
    pat = re.compile(rf"(?<![A-Za-z0-9]){re.escape(key)}(?![0-9])")
    return [w["path"] for w in ws if not w.get("isMainWorktree") and pat.search(os.path.basename(w.get("path") or ""))]


def merged_into_base(path, head):
    """HEAD is already in a base branch the remote holds (origin/HEAD, main, master, develop, support/*) — a branch
    with nothing of its own, or one merged with a merge commit / fast-forward."""
    remotes = (git(path, "for-each-ref", "--format=%(refname:short)", "refs/remotes/origin") or "").splitlines()
    # 분리된 HEAD 는 확인용 체크아웃(예: 실측이 채운 web-dev 서브모듈)이라 원격 어느 브랜치에든 있으면 남길 것이 없다.
    if git(path, "rev-parse", "--abbrev-ref", "HEAD") == "HEAD":
        bases = [r for r in remotes if r != "origin/HEAD"]
    else:
        bases = [r for r in remotes
                 if r in ("origin", "origin/main", "origin/master", "origin/develop") or r.startswith("origin/support/")]
    return any(subprocess.run(["git", "-C", path, "merge-base", "--is-ancestor", head, b], capture_output=True).returncode == 0
               for b in bases)


def merged_pr_heads(path):
    """Heads of the merged PRs opened from this checkout's branch (squash merges leave no ancestry). None when gh fails."""
    branch = git(path, "rev-parse", "--abbrev-ref", "HEAD")
    if not branch or branch == "HEAD":
        return set()
    r = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "merged", "--json", "headRefOid"],
                       cwd=path, capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return None
    return {d["headRefOid"] for d in json.loads(r.stdout or "[]")}


def repo_problems(path, merged_heads=()):
    """Uncommitted changes, or a HEAD that is not merged — neither in a remote base branch nor the head of a merged
    PR (delivered/ record or gh). A pushed but unmerged branch counts: its open PR still needs the worktree. Submodule
    pointer moves in a superproject are not changes of its own (each populated submodule is checked by itself)."""
    out = []
    if git(path, "status", "--porcelain", "--ignore-submodules=all"):
        out.append(f"{path}: 커밋하지 않은 변경")
    head = git(path, "rev-parse", "HEAD")
    if head and head not in merged_heads and not merged_into_base(path, head):
        pr_heads = merged_pr_heads(path)
        if pr_heads is None:
            out.append(f"{path}: 머지 여부 확인 실패 (gh)")
        elif head not in pr_heads:
            out.append(f"{path}: 머지되지 않은 커밋 ({head[:9]})")
    return out


def cleanup_plan(wts, merged_heads=()):
    """[(worktree, populated submodules)] and what would be lost by removing them."""
    plan, problems = [], []
    for wt in wts:
        subs = []
        if os.path.isfile(os.path.join(wt, ".gitmodules")):
            for line in (git(wt, "config", "--file", ".gitmodules", "--get-regexp", r"^submodule\..*\.path$") or "").splitlines():
                sub = line.split()[1]
                if os.path.exists(os.path.join(wt, sub, ".git")):
                    subs.append(sub)
                    problems += repo_problems(os.path.join(wt, sub), merged_heads)
        problems += repo_problems(wt, merged_heads)
        plan.append((wt, subs))
    return plan, problems


def cleanup_execute(st, key, plan):
    for wt, subs in plan:
        for sub in subs:
            subprocess.run(["git", "-C", wt, "submodule", "deinit", "-f", "--", sub], capture_output=True, timeout=120)
        # Without --force orca reports removed:true yet leaves the worktree in place; loss checks run before this.
        orca("worktree", "rm", "--worktree", f"path:{wt}", "--force", timeout=300)
        log(st, f"CLEANUP {key} {wt}")
    os.makedirs(st.p("cleaned"), exist_ok=True)
    with open(st.p("cleaned", key), "w", encoding="utf-8") as f:
        f.write(f"{now()}\t{' '.join(wt for wt, _ in plan)}\n")
    # Cleanup runs once the PRs are merged (or Jira closed the ticket), so a 막힘 left from before — a merge conflict
    # the coordinator then resolved — is settled; left in place it would keep the ticket in 내 차례.
    for f in st.has("blocked", key):
        os.remove(st.p("blocked", f))
        log(st, f"UNBLOCK {key} {f} (cleaned)")


def cmd_cleanup(st, a):
    st.load()
    key, wts = a.key, ticket_worktrees(st, a.key)
    if not wts:
        die(f"{key}: 정리할 워크트리가 없다")
    plan, problems = cleanup_plan(wts, merged_heads(st, key))
    for wt, subs in plan:
        print(f"정리: {wt}" + (f" (deinit: {', '.join(subs)})" if subs else ""))
    if problems and not a.force:
        die("멈춤 — " + " · ".join(problems) + " (--force 로 무시)", 3)
    if a.dry_run:
        return
    cleanup_execute(st, key, plan)


PR_URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/pull/\d+")


def delivered_prs(st, key):
    """{PR url: (state, head oid)} for every PR named in delivered/<KEY>.md. Raises when gh cannot answer."""
    try:
        text = open(st.p("delivered", f"{key}.md"), encoding="utf-8").read()
    except OSError:
        return {}
    prs = {}
    for url in dict.fromkeys(PR_URL.findall(text)):
        r = subprocess.run(["gh", "pr", "view", url, "--json", "state,headRefOid"], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            raise RuntimeError(f"gh pr view {url}: {r.stderr.strip()[:200]}")
        d = json.loads(r.stdout)
        prs[url] = (d["state"], d["headRefOid"])
    return prs


def merged_heads(st, key):
    try:
        return {head for state, head in delivered_prs(st, key).values() if state == "MERGED"}
    except (RuntimeError, OSError) as e:
        print(f"qa-driver: {key} PR 조회 실패, 머지 판정 없이 정리 검사 — {e}", file=sys.stderr)
        return set()


def finished_cleanups(st, done_keys):
    """Tickets with a driver-recorded worktree (still present, or already removed outside the driver) that are finished — every PR in delivered/<KEY>.md
    merged, or no PR at all and the Jira status is one of QA_STATUS_DONE (a ticket closed without a fix):
    [(key, plan, problems)]. An open PR keeps the worktree whatever Jira says — the merge step still needs it.
    Only worktrees the driver recorded — never a name-matched guess."""
    out = []
    for r in status_rows(st):
        wt = (st.ticket(r["key"]).get("worktree") or {}).get("path")
        if r["stage"] == "cleaned" or not wt:
            continue
        # 2회차부터 Jira 완료 상태는 이전 회차 머지의 잔상일 수 있어, 이번 회차 반출 PR 머지로만 정리한다.
        no_fix_closable = r["key"] in done_keys and len(st.claims(r["key"])) <= 1
        if r["stage"] != "delivered" and not no_fix_closable:
            continue
        try:
            prs = delivered_prs(st, r["key"])
        except (RuntimeError, OSError) as e:
            print(f"qa-driver: {r['key']} PR 조회 실패, 이번 회차 정리 건너뜀 — {e}", file=sys.stderr)
            continue
        if prs and all(state == "MERGED" for state, _ in prs.values()) or not prs and no_fix_closable:
            # 드라이버 밖에서 이미 지운 워크트리는 지울 것 없이 정리 표시만 남긴다.
            plan, problems = cleanup_plan([wt] if os.path.isdir(wt) else [], {head for _, head in prs.values()})
            out.append((r["key"], plan, problems))
    return out


def sweep_finished(st, done_keys):
    """Close the live terminals of each finished ticket and remove its worktree. A ticket with something unpushed
    stays and is logged once per distinct reason."""
    for key, plan, problems in finished_cleanups(st, done_keys):
        t = st.ticket(key)
        if problems:
            reason = " · ".join(problems)
            if t.get("cleanup_skip") != reason:
                t["cleanup_skip"] = reason
                st.save_ticket(t)
                log(st, f"CLEANUP-SKIP {key}: {reason}")
            continue
        live = live_handles()
        for h in ticket_handles(st, key):
            if h in live:
                orca("terminal", "close", "--terminal", h, timeout=60)
                log(st, f"CLOSE {key} {h}")
        try:
            cleanup_execute(st, key, plan)
        except Exception as e:
            log(st, f"ERROR cleanup {key}: {e}")


def ticket_handles(st, key):
    """Every terminal this ticket ever had: each claim's coordinator, the recorded coordinator, its workers."""
    t = st.ticket(key)
    hs = [c[2] for c in st.claims(key) if len(c) > 2 and c[2]]
    hs += [(t.get("coordinator") or {}).get("handle")] + [w.get("handle") for w in (t.get("workers") or {}).values()]
    return [h for i, h in enumerate(hs) if h and h not in hs[:i]]


def automations_of(st):
    try:
        res = orca("automations", "list")
    except Exception:
        return []
    autos = res.get("automations", res) if isinstance(res, dict) else res
    hit = re.compile(rf"(?<![A-Za-z0-9]){re.escape(st.parent)}(?![0-9])")
    return [x for x in autos if hit.search(" ".join([x.get("name") or "", x.get("prompt") or "",
                                                      (x.get("precheck") or {}).get("command") or ""]))]


def cmd_restart(st, a):
    st.load()
    key, t = a.key, st.ticket(a.key)
    brief = st.p("briefs", f"{key}.md")
    if not os.path.isfile(brief):
        die(f"{brief} 가 없다 — 기동된 적 없는 티켓은 drive 로 띄운다")
    wt = (t.get("worktree") or {}).get("path") or st.get("QA_COORD_WORKTREE")
    if not (wt and os.path.isdir(wt)):
        die(f"{key}: 코디네이터를 띄울 워크트리가 없다 ({wt or '기록 없음'})")
    live = [h for h in ticket_handles(st, key) if h in live_handles()]
    if live and not a.force:
        die(f"{key}: 살아 있는 터미널이 있다 ({', '.join(live)}) — 먼저 close 하거나 --force")
    h = start_agent(st, wt, f"{key} 코디네이터 (재기동)", brief,
                    "이전 코디네이터가 멈춰 다시 띄웠다. 기록 파일과 상태 디렉터리의 신호로 어디까지 했는지 먼저 확인하고 거기서 이어서 하라.")
    t.update(key=key)
    t["coordinator"] = {"handle": h, "at": now(), "round": len(st.claims(key)), "for": "restart"}
    st.save_ticket(t)
    log(st, f"RESTART {key} ({h})")
    print(h)


def cmd_close(st, a):
    st.load()
    live = live_handles()
    for key in a.keys:
        for h in ticket_handles(st, key):
            if h in live:
                try:
                    orca("terminal", "close", "--terminal", h, timeout=60)
                    log(st, f"CLOSE {key} {h}")
                    print(f"닫음: {key} {h}")
                except Exception as e:
                    print(f"실패: {key} {h} — {e}", file=sys.stderr)


def cmd_retire(st, a):
    st.load()
    autos = [x for x in automations_of(st) if x.get("enabled")]
    open_ = [r["key"] for r in status_rows(st) if r["stage"] in ACTIVE and not r["ignored"]]
    coord = st.get("QA_COORD_WORKTREE")
    coord = coord if coord and os.path.isdir(coord) else None
    terms = []
    try:
        terms = [x["handle"] for x in orca("terminal", "list").get("terminals") or []
                 if x.get("connected") and coord and (x.get("worktreePath") or "").rstrip("/") == coord.rstrip("/")]
    except Exception:
        pass
    problems = []
    if coord:
        problems += repo_problems_root(coord)
    print(f"자동화 끄기: {', '.join(x.get('name') or x['id'] for x in autos) or '없음'}")
    print(f"조정 워크트리: {coord or '없음'}" + (f" (열린 터미널 {len(terms)}개를 닫고 지움)" if coord else ""))
    if open_:
        print(f"아직 검토 전인 티켓: {', '.join(open_)}")
    if (open_ or problems) and not a.force:
        die("멈춤 — " + " · ".join(([f"검토 전 티켓 {len(open_)}개"] if open_ else []) + problems) + " (--force 로 무시)", 3)
    if a.dry_run:
        return
    for x in autos:
        orca("automations", "edit", x["id"], "--disabled", timeout=30)
        log(st, f"RETIRE automation off {x['id']}")
    for h in terms:
        try:
            orca("terminal", "close", "--terminal", h, timeout=60)
        except Exception as e:
            print(f"터미널 {h} 닫기 실패 — {e}", file=sys.stderr)
    if coord:
        for line in (git(coord, "config", "--file", ".gitmodules", "--get-regexp", r"^submodule\..*\.path$") or "").splitlines():
            sub = line.split()[-1]
            if os.path.exists(os.path.join(coord, sub, ".git")):
                subprocess.run(["git", "-C", coord, "submodule", "deinit", "-f", "--", sub], capture_output=True, timeout=120)
        orca("worktree", "rm", "--worktree", f"path:{coord}", "--force", timeout=300)
        log(st, f"RETIRE removed {coord}")
    with open(st.p("retired"), "w", encoding="utf-8") as f:
        f.write(now() + "\n")


def repo_problems_root(path):
    """A shared coordination worktree: its own uncommitted files only (submodules there are read-only checkouts)."""
    return [f"{path}: 커밋하지 않은 변경"] if git(path, "status", "--porcelain", "--ignore-submodules=all") else []


ADOPT_NEED = ("JIRA_SITE", "JIRA_EMAIL", "QA_REPO", "QA_AUTO_HANDOFF", "QA_STATUS_NEW", "QA_STATUS_REOPEN")


def cmd_adopt(st, a):
    st.load()
    sets = dict(kv.split("=", 1) for kv in a.set if "=" in kv)
    hints = {}
    coord = st.get("QA_COORD_WORKTREE")
    if coord and os.path.isdir(coord):  # the older watcher's worktree belongs to the repo the driver should use
        common = git(coord, "rev-parse", "--path-format=absolute", "--git-common-dir")
        if common:
            hints["QA_REPO"] = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    missing = [k for k in ADOPT_NEED if not (st.get(k) or sets.get(k))]
    autos = automations_of(st)
    if a.check:
        print(json.dumps({"missing": missing, "hints": hints, "automations": [
            {"id": x["id"], "name": x.get("name"), "enabled": x.get("enabled"), "adopted": "qa-driver" in (x.get("prompt") or "")}
            for x in autos]}, ensure_ascii=False))
        return
    if missing:
        die("config.env 에 없는 키: " + ", ".join(missing) + " (--set KEY=값)")
    target = [x for x in autos if x["id"] == a.automation] if a.automation else autos
    if len(target) != 1:
        die(f"바꿀 자동화를 하나로 정하지 못했다 ({len(target)}개) — --automation <id>")
    if sets:
        with open(st.p("config.env"), "a", encoding="utf-8") as f:
            f.write(f"\n# qa-ticket-driver 이관 ({now()})\n" + "".join(f'{k}={shlex.quote(v)}\n' for k, v in sets.items()))
    drv = os.path.join(SKILL_DIR, "bin", "qa-driver")
    base = f'{shlex.quote(drv)} --home {shlex.quote(st.home)} run {st.parent}'
    orca("automations", "edit", target[0]["id"], "--precheck", f"{base} --pending",
         "--prompt", f"{base} 를 한 번 실행하고 마지막 줄만 보고하라. 다른 일은 하지 않는다.", timeout=30)
    log(st, f"ADOPT automation {target[0]['id']} → qa-driver" + (f" (설정 추가: {', '.join(sets)})" if sets else ""))
    print(f"이관: {target[0].get('name') or target[0]['id']} 가 이제 qa-driver run 을 부른다")


def cmd_ignore(st, a):
    os.makedirs(st.p("ignored"), exist_ok=True)
    p = st.p("ignored", a.key)
    if a.undo:
        if os.path.exists(p):
            os.remove(p)
    else:
        open(p, "a").close()
    log(st, f"{'UNIGNORE' if a.undo else 'IGNORE'} {a.key}")


def main():
    ap = argparse.ArgumentParser(prog="qa-driver", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--home", help="state home (default $QA_DRIVER_HOME or ~/.qa-driver)")
    sp = ap.add_subparsers(dest="cmd", required=True)
    for name in ("init", "run", "drive", "worker", "status", "approve", "merge", "tell", "cleanup", "ignore", "restart", "close", "retire", "adopt"):
        p = sp.add_parser(name)
        p.add_argument("parent")
        if name in ("drive", "worker", "approve", "merge", "cleanup", "ignore", "restart"):
            p.add_argument("key")
        if name == "close":
            p.add_argument("keys", nargs="+")
        if name == "restart":
            p.add_argument("--force", action="store_true")
        if name == "retire":
            p.add_argument("--dry-run", action="store_true")
            p.add_argument("--force", action="store_true")
        if name == "adopt":
            p.add_argument("--check", action="store_true")
            p.add_argument("--set", action="append", default=[])
            p.add_argument("--automation")
        if name == "worker":
            p.add_argument("submodule", nargs="?")
            p.add_argument("--screen", action="store_true")
        if name == "run":
            g = p.add_mutually_exclusive_group()
            g.add_argument("--dry-run", action="store_true")
            g.add_argument("--pending", action="store_true")
        if name == "status":
            p.add_argument("--json", action="store_true")
        if name == "approve":
            p.add_argument("--force", action="store_true")
        if name in ("approve", "merge"):
            p.add_argument("--by", default="사용자")
        if name == "cleanup":
            p.add_argument("--force", action="store_true")
            p.add_argument("--dry-run", action="store_true")
        if name == "ignore":
            p.add_argument("--undo", action="store_true")
        if name == "tell":
            p.add_argument("--to", required=True, help="receiver's terminal handle (term_...)")
            p.add_argument("--type", default="status", choices=TELL_TYPES)
            p.add_argument("--subject", default="")
            p.add_argument("--body", required=True, help="text typed into the terminal; - reads stdin")
            p.add_argument("--key", help="ticket key")
            p.add_argument("--from", dest="sender", help="sender (default $ORCA_TERMINAL_HANDLE)")
    a = ap.parse_args()
    for k in ([a.key] if getattr(a, "key", None) else []) + (getattr(a, "keys", None) or []):
        if not re.fullmatch(r"[A-Z][A-Z0-9]+-\d+", k):
            die(f"티켓 키 형식이 아니다: {k}")
    st = State(a.parent.upper(), a.home)
    try:
        globals()["cmd_" + a.cmd](st, a)
    except RuntimeError as e:
        die(str(e))


if __name__ == "__main__":
    main()
